# bump: scipy-version /SCIPY_VERSION="(.*)"/ https://github.com/scipy/scipy.git|semver:*
SCIPY_VERSION="1.18.0"

###
### Build control file for scipyport
###
### scipy sits on top of everything else in the numerical stack: numpy for
### arrays, BLIS for BLAS, lapack for LAPACK, meson for the build, and the
### fortran port for the four Fortran sources that remain.
###
### Unlike numpyport this port does not carry meson patches. numpy vendors its
### own fork of meson; scipy uses the system one, so the z/OS support in
### mesonport -- including its Fortran compiler class -- applies directly.
###
### Three things are handled below.
###
###   1. Build backend and helpers. scipy builds through meson-python and needs
###      Cython, pybind11 and pythran. All four have pure-Python wheels at the
###      versions scipy pins, so they install without compiling anything. They
###      go into the venv rather than being resolved by build isolation, so the
###      build uses the system meson rather than fetching its own.
###
###   2. String literal encoding. The C compiler emits EBCDIC literals by
###      default while the interpreter is an ASCII build, so extensions compile,
###      link and install perfectly and then fail to import. The flags come from
###      sysconfig plus -fzos-le-char-mode=ascii; setuptools passes these for
###      extension builds, meson does not.
###
###   3. Python symbols and metadata. Extensions must bind against the
###      interpreter's side deck, and the shipped pkg-config files and LIBDIR
###      name the machine the interpreter was built on rather than where it is
###      installed. Both are recomputed per interpreter. Same as numpyport.
###

export ZOPEN_PROJECT_NAME="scipy"

export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/scipy/scipy.git"
export ZOPEN_STABLE_TAG="v${SCIPY_VERSION}"
export ZOPEN_DEV_URL="https://github.com/scipy/scipy.git"

# scipy carries its vendored dependencies (boost, highs, ...) as submodules.
export ZOPEN_CLONE_SUBMODULES="yes"

# numpy is deliberately NOT a build dependency, even though the build needs it.
# Declaring it puts it on PYTHONPATH, pip then considers it already installed
# and puts none in the venv, and the build ends up using the zopen port's
# console scripts -- whose shebangs name the system interpreter, so they only
# work when PYTHONPATH is set. meson runs them without it and scipy dies at
#
#   ERROR: Command `.../bin/f2py -v` failed with status 1
#
# Installing numpy into the venv instead (from the zopen wheel index, below)
# gives the self-contained environment scipy's meson.build expects: its own
# f2py and numpy-config, resolving numpy from the venv with no PYTHONPATH.
export ZOPEN_STABLE_DEPS="check_python meson ninja pkgconfig curl git patch fortran lapack blis"
export ZOPEN_DEV_DEPS="${ZOPEN_STABLE_DEPS}"
export ZOPEN_RUNTIME_DEPS="check_python numpy"
export ZOPEN_CATEGORIES="development library math"

export ZOPEN_PYTHON_VERSIONS="3.12 3.13 3.14"
export ZOPEN_BUILD_SYSTEM="Python"

# The compiler is taken from sysconfig per interpreter, not from zopen.
export ZOPEN_COMP="skip"
export ZOPEN_CONFIGURE="skip"
export ZOPEN_MAKE="zopen_custom_build"

# BLAS is BLIS; LAPACK is the reference build. Both are found through
# pkg-config, which is why each ships a .pc.
SCIPY_MESON_ARGS="-Dblas=blis -Dlapack=lapack"

zopen_get_version() {
  echo "${SCIPY_VERSION}"
}

# --- per-interpreter facts, all recomputed rather than trusted -------------

# scipy enforces clang >= 15 in its own meson.build ("SciPy requires clang >=
# 15.0"). sysconfig reports the compiler the interpreter was built with, which
# is older than that here, so prefer the newest clang installed on the machine
# and fall back to sysconfig's only when nothing newer exists -- in which case
# scipy's own check produces the clear error.
#
# Building extensions with a newer compiler than the interpreter was built with
# is safe on this platform: they meet across the C ABI, and both target the same
# LE runtime. Verified by building an extension with the newer clang and
# importing it into the interpreter built with the older one.
#
# Set ZOPEN_CLANG_ROOT to point at an install root holding <version>/bin/clang
# if the compilers live somewhere unusual.
_scipy_pick_compiler() {
  _pc_want="$1"
  _pc_fallback="$2"
  "$(_zopen_python_interpreter_path "$3")" - "${_pc_want}" "${_pc_fallback}" <<'CCEOF'
import glob
import os
import re
import shutil
import subprocess
import sys

want, fallback = sys.argv[1], sys.argv[2]

roots = []
if os.environ.get("ZOPEN_CLANG_ROOT"):
    roots.append(os.environ["ZOPEN_CLANG_ROOT"])
if fallback and os.path.exists(fallback):
    # .../oelcpp/<version>/bin/clang -> .../oelcpp
    roots.append(os.path.dirname(os.path.dirname(os.path.dirname(fallback))))
roots += ["/usr/lpp/IBM/oelcpp", "/data/usr/lpp/IBM/oelcpp"]

candidates = []
for root in roots:
    candidates += glob.glob(os.path.join(root, "*", "bin", want))
on_path = shutil.which(want)
if on_path:
    candidates.append(on_path)
if fallback:
    candidates.append(fallback)

best, best_version = None, ()
for candidate in candidates:
    if not os.access(candidate, os.X_OK):
        continue
    try:
        out = subprocess.run([candidate, "--version"], capture_output=True,
                             text=True, timeout=60).stdout
    except Exception:
        continue
    # The banner carries IBM's product version before the clang version.
    match = re.search(r"clang version (\d+(?:\.\d+)*)", out)
    if not match:
        continue
    version = tuple(int(part) for part in match.group(1).split("."))
    if version > best_version:
        best, best_version = candidate, version

if best and best_version >= (15,):
    print(best)
else:
    print(fallback)
CCEOF
}

_scipy_cc() {
  _cc_fallback=$("$(_zopen_python_interpreter_path "$1")" -c \
    'import sysconfig; print(sysconfig.get_config_var("CC"))')
  _scipy_pick_compiler "clang" "${_cc_fallback}" "$1"
}

_scipy_cxx() {
  _cxx_fallback=$("$(_zopen_python_interpreter_path "$1")" -c \
    'import sysconfig; print(sysconfig.get_config_var("CXX") or sysconfig.get_config_var("CC"))')
  _scipy_pick_compiler "clang++" "${_cxx_fallback}" "$1"
}

_scipy_zos_flags() {
  "$(_zopen_python_interpreter_path "$1")" -c '
import sysconfig
base = sysconfig.get_config_var("CFLAGS") or ""
print(base + " -m64 -fvisibility=default -fzos-le-char-mode=ascii -fno-short-enums")
'
}

# The directory actually holding libpython<version>.x. LIBDIR records where the
# interpreter was built, which is not always where it lives.
_scipy_python_libdir() {
  "$(_zopen_python_interpreter_path "$1")" -c '
import os, sys, sysconfig
version = sysconfig.get_config_var("VERSION")
candidates = [os.path.join(getattr(sys, "base_prefix", sys.prefix), "lib")]
libdir = sysconfig.get_config_var("LIBDIR")
if libdir:
    candidates.append(libdir)
for candidate in candidates:
    if os.path.exists(os.path.join(candidate, "libpython%s.x" % version)):
        print(candidate)
        break
else:
    sys.exit("no libpython%s.x found in: %s" % (version, ", ".join(candidates)))
'
}

# A corrected python-<version>.pc, ahead of the shipped one on PKG_CONFIG_PATH.
_scipy_pkgconfig_dir() {
  _pc_pv="$1"
  _pc_dir="${PWD}/.zopen-pkgconfig/${_pc_pv}"
  mkdir -p "${_pc_dir}" || return 1
  "$(_zopen_python_interpreter_path "${_pc_pv}")" - "${_pc_dir}" <<'PCEOF'
import os, sys, sysconfig
out_dir = sys.argv[1]
version = sysconfig.get_config_var("VERSION")
prefix = getattr(sys, "base_prefix", sys.prefix)
libdir = os.path.join(prefix, "lib")
if not os.path.isdir(libdir):
    libdir = sysconfig.get_config_var("LIBDIR") or os.path.join(prefix, "lib")
incdir = os.path.dirname(sysconfig.get_paths()["include"])
with open(os.path.join(out_dir, "python-%s.pc" % version), "w") as fh:
    fh.write(
        "# Regenerated from sysconfig by scipyport: the shipped file names the\n"
        "# machine this interpreter was built on, not where it is installed.\n"
        "prefix=%s\nexec_prefix=${prefix}\nlibdir=%s\nincludedir=%s\n\n"
        "Name: Python\nDescription: Build a C extension for Python\n"
        "Requires:\nVersion: %s\nLibs.private:\nLibs: -L${libdir}\n"
        "Cflags: -I${includedir}/python%s\n"
        % (prefix, libdir, incdir, version, version))
PCEOF
  [ -f "${_pc_dir}/python-${_pc_pv}.pc" ] || return 1
  echo "${_pc_dir}"
}

zopen_pre_build() {
  # The sources are ASCII; tag them so z/OS tools do not read them as EBCDIC.
  find . -type f \( -name '*.c' -o -name '*.h' -o -name '*.cpp' -o -name '*.hpp' \
       -o -name '*.pyx' -o -name '*.pxd' -o -name '*.py' -o -name '*.f' \
       -o -name '*.build' -o -name '*.toml' \) \
    -exec chtag -tc ISO8859-1 {} + 2> /dev/null
  return 0
}

zopen_custom_build() {
  _zopen_python_verify_interpreters || return 1
  rm -rf dist

  # meson-python declares a dependency on meson, so pip installs one from PyPI
  # into each venv and the venv's bin/ shadows the ported meson on PATH. The
  # PyPI build has no z/OS support and the build dies at
  #
  #   ERROR: Unable to detect linker for compiler `... -Wl,--version ...`
  #
  # even though the binder's IEW5033 is right there in the probe's stderr --
  # that is precisely what mesonport patches teach meson to recognise. Capture
  # the ported meson now, before any venv is on PATH, and point meson-python at
  # it: the MESON environment variable overrides everything else it would try.
  # A venv's console scripts are written ASCII-tagged, and z/OS only honours
  # the shebang of such a file when this is on -- otherwise the shell runs it
  # as a shell script and reports "FSUM7332 syntax error". scipy runs f2py
  # through meson's run_command, so it has to work.
  _BPXK_AUTOCVT=ON
  export _BPXK_AUTOCVT

  _sb_meson=$(command -v meson)
  [ -n "${_sb_meson}" ] \
    || printError "meson is not on PATH -- is the meson port a build dependency?"
  MESON="${_sb_meson}"
  export MESON
  printVerbose "MESON=${MESON} ($(${MESON} --version 2>/dev/null))"

  _sb_rc=0
  for _sb_pv in $(_zopen_python_versions); do
    printHeader "Building wheel with Python ${_sb_pv}"
    _zopen_python_ensure_venv_for "${_sb_pv}" || { _sb_rc=1; break; }

    # scipy's build requirements, pinned by its pyproject. Every one of these
    # has a pure-Python wheel, so nothing is compiled to install them.
    # numpy comes from the zopen wheel index -- PyPI has no wheel for this
    # platform and there is no compiler-free way to build one here. Everything
    # else is a pure-Python wheel at the versions scipy pins.
    pip install --disable-pip-version-check --quiet --only-binary=:all: \
      --extra-index-url https://repo.zopen.community/pypi/wheels/simple/ \
      "numpy>=2.0.0,<2.8" \
      "meson-python>=0.15.0,<0.22.0" "Cython>=3.2.0,<3.3.0" \
      "pybind11>=2.13.2,<3.1.0" "pythran>=0.18.1,<0.19.0" \
      || { _sb_rc=1; deactivate; break; }

    _sb_pc="$(_scipy_pkgconfig_dir "${_sb_pv}")" \
      || { printSoftError "Could not write a corrected python-${_sb_pv}.pc"; _sb_rc=1; deactivate; break; }

    # meson resolves dependency('numpy') by pkg-config first and the
    # numpy-config executable second. Give it the pkg-config file numpy ships
    # inside the wheel: the executable route needs the console script to run,
    # and a venv's console scripts are ASCII-tagged, so z/OS only honours their
    # shebang when _BPXK_AUTOCVT=ON. Without this the build stops at
    #
    #   numpy-config found: NO
    #   Run-time dependency numpy found: NO (tried pkg-config and config-tool)
    _sb_nppc=$(python -c 'import os, numpy
print(os.path.join(os.path.dirname(numpy.__file__), "_core", "lib", "pkgconfig"))' 2> /dev/null)
    if [ -n "${_sb_nppc}" ] && [ -d "${_sb_nppc}" ]; then
      _sb_pc="${_sb_pc}:${_sb_nppc}"
    else
      printSoftError "numpy ships no pkgconfig directory; dependency('numpy') may not resolve"
    fi
    # blis and lapack are declared dependencies, so zopen has already put their
    # lib/pkgconfig and share/pkgconfig on PKG_CONFIG_PATH. Only the corrected
    # python-<version>.pc needs prepending, ahead of the interpreter's own.
    PKG_CONFIG_PATH="${_sb_pc}${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
    export PKG_CONFIG_PATH

    CC="$(_scipy_cc "${_sb_pv}")"
    CXX="$(_scipy_cxx "${_sb_pv}")"
    export CC CXX
    CFLAGS="$(_scipy_zos_flags "${_sb_pv}")"
    CXXFLAGS="${CFLAGS}"
    LDFLAGS="$(_scipy_python_libdir "${_sb_pv}")/libpython${_sb_pv}.x"
    export CFLAGS CXXFLAGS LDFLAGS
    # FC comes from the fortran port's environment; meson needs it on PATH.
    printVerbose "PKG_CONFIG_PATH=${PKG_CONFIG_PATH}"
    printVerbose "CC=${CC}  FC=${FC:-unset}"
    printVerbose "LDFLAGS=${LDFLAGS}"

    # shellcheck disable=SC2086
    python -m build --wheel --no-isolation \
      $(for _sb_a in ${SCIPY_MESON_ARGS}; do echo "-Csetup-args=${_sb_a}"; done)
    _sb_rc=$?

    if [ ${_sb_rc} -eq 0 ]; then
      _zopen_python_retag_wheel
      _sb_rc=$?
    fi
    if [ ${_sb_rc} -eq 0 ]; then
      _zopen_python_stamp_wheel
      _sb_rc=$?
    fi

    deactivate
    [ ${_sb_rc} -eq 0 ] || break
  done
  return ${_sb_rc}
}

# scipy's own test suite is not run here. It needs pytest and hypothesis for
# every interpreter, and hypothesis cannot be installed on this platform yet
# (its build backend is maturin, which needs a Rust toolchain that does not
# exist here). Running a smoke check that exercises the parts this port exists
# to get right is more useful than a suite that cannot start.
zopen_python_test() {
  SCIPY_EXPECTED_VERSION="${SCIPY_VERSION}" python - <<'PYEOF'
import os
import sys
import tempfile

print("Running tests with Python %s" % sys.version.split()[0])

# zopen's environment leaves PYTHONPATH with a leading empty entry, because
# ports build it as "${PYTHONPATH}:..." from an unset variable. Python expands
# that to the working directory at interpreter startup, which puts the *source
# tree* on sys.path -- and scipy's package sits at the repository root, so it
# shadows the installed wheel and fails with an import error that reads like a
# broken build. Remove the source directory by name; dropping "" is too late.
_src = os.path.realpath(os.getcwd())
os.chdir(tempfile.gettempdir())
sys.path = [p for p in sys.path
            if p not in ("", ".") and os.path.realpath(p) != _src]

failures = 0
total = 0


def check(label, fn):
    global failures, total
    total += 1
    try:
        if fn():
            print("PASS:", label)
        else:
            print("FAIL:", label, file=sys.stderr)
            failures += 1
    except Exception as exc:
        print("FAIL:", label, "-", exc, file=sys.stderr)
        failures += 1


try:
    import numpy as np
    import scipy
except ImportError as exc:
    # The failure this port exists to prevent looks exactly like this, and the
    # message names Unicode rather than the compiler: extensions built with
    # EBCDIC string literals import as mojibake.
    print("FAIL: import scipy -", exc, file=sys.stderr)
    print("scipy FAILED to import on Python %s -- 0 passed, 1 failed"
          % sys.version.split()[0])
    sys.exit(1)

check("version is the one this port builds",
      lambda: scipy.__version__ == os.environ["SCIPY_EXPECTED_VERSION"])

# linalg is the whole point of pairing this with BLIS and LAPACK: unlike numpy,
# which falls back to its bundled lapack_lite, these calls go through the real
# libraries. A wrong result here means the Fortran symbol mangling is wrong.
from scipy import linalg

check("linalg.solve",
      lambda: np.allclose(linalg.solve(np.array([[3., 1.], [1., 2.]]),
                                       np.array([9., 8.])),
                          np.array([2., 3.])))

check("linalg.det",
      lambda: abs(linalg.det(np.array([[4., 7.], [2., 6.]])) - 10.0) < 1e-9)

check("linalg.inv round-trips",
      lambda: np.allclose(np.array([[4., 7.], [2., 6.]])
                          @ linalg.inv(np.array([[4., 7.], [2., 6.]])),
                          np.eye(2)))

check("linalg.eigh on a symmetric matrix",
      lambda: np.allclose(sorted(linalg.eigh(np.array([[2., 1.], [1., 2.]]))[0]),
                          [1.0, 3.0]))

check("linalg.svd reconstructs",
      lambda: (lambda a: np.allclose(
          (lambda u, s, vt: u @ np.diag(s) @ vt)(*linalg.svd(a, full_matrices=False)), a))(
              np.array([[1., 2.], [3., 4.], [5., 6.]])))

check("linalg.cholesky",
      lambda: np.allclose(linalg.cholesky(np.array([[4., 2.], [2., 3.]]), lower=True)
                          @ linalg.cholesky(np.array([[4., 2.], [2., 3.]]), lower=True).T,
                          np.array([[4., 2.], [2., 3.]])))

check("linalg.lu_factor / lu_solve",
      lambda: np.allclose(
          linalg.lu_solve(linalg.lu_factor(np.array([[3., 1.], [1., 2.]])),
                          np.array([9., 8.])),
          np.array([2., 3.])))

# Cython extensions
from scipy import sparse
check("sparse matmul (Cython)",
      lambda: (sparse.csr_matrix(np.eye(3)) @ np.array([1., 2., 3.])).tolist()
              == [1.0, 2.0, 3.0])

check("sparse.linalg.spsolve",
      lambda: np.allclose(
          __import__("scipy.sparse.linalg", fromlist=["spsolve"]).spsolve(
              sparse.csc_matrix(np.array([[3., 1.], [1., 2.]])),
              np.array([9., 8.])),
          np.array([2., 3.])))

# pythran-generated C++
from scipy import optimize
check("optimize.brentq",
      lambda: abs(optimize.brentq(lambda x: x * x - 2.0, 0.0, 2.0)
                  - 2.0 ** 0.5) < 1e-9)

check("optimize.minimize converges",
      lambda: abs(optimize.minimize(lambda v: (v[0] - 3.0) ** 2,
                                    [0.0]).x[0] - 3.0) < 1e-6)

from scipy import fft as sfft
check("fft round-trips",
      lambda: np.allclose(
          sfft.ifft(sfft.fft(np.array([1., 2., 3., 4.]))).real,
          np.array([1., 2., 3., 4.])))

from scipy import stats
check("stats.norm.cdf",
      lambda: abs(stats.norm.cdf(0.0) - 0.5) < 1e-12)

check("stats.ttest_1samp runs",
      lambda: stats.ttest_1samp(np.array([1., 2., 3., 4., 5.]), 3.0).pvalue > 0.9)

from scipy import interpolate
# CubicSpline rather than interp1d: interp1d is legacy, and a smoke check should
# not be the thing that breaks on a deprecation.
check("interpolate.CubicSpline",
      lambda: abs(float(interpolate.CubicSpline([0., 1., 2., 3.],
                                                [0., 10., 20., 30.])(1.5))
                  - 15.0) < 1e-6)

from scipy import integrate
check("integrate.quad",
      lambda: abs(integrate.quad(lambda x: x * x, 0.0, 3.0)[0] - 9.0) < 1e-9)

# z/OS is big-endian and few builds exercise that path.
check("native byte order is big-endian",
      lambda: sys.byteorder == "big")

check("byteswap round-trips through scipy",
      lambda: linalg.norm(np.array([3., 4.]).astype(">f8")) == 5.0)

print("scipy %s on Python %s -- %d passed, %d failed" % (
    scipy.__version__, sys.version.split()[0], total - failures, failures))
sys.exit(1 if failures else 0)
PYEOF
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="${dir}/${pfx}_check.log"
  # No "|| echo 0": grep -c prints 0 when nothing matches and also exits 1, so
  # the fallback appends a second zero and the arithmetic dies.
  passed=$(grep -c "^PASS:" "${chk}" 2> /dev/null)
  failed=$(grep -c "^FAIL:" "${chk}" 2> /dev/null)
  passed=${passed:-0}
  failed=${failed:-0}

  # An interpreter whose script dies before the first check contributes no PASS
  # and no FAIL, so counting those alone would score a crash as a clean run.
  interpreters=$(grep -c "Running tests with Python" "${chk}" 2> /dev/null)
  reported=$(grep -c "^scipy .* on Python" "${chk}" 2> /dev/null)
  interpreters=${interpreters:-0}
  reported=${reported:-0}
  silent=$((interpreters - reported))
  if [ "${silent}" -gt 0 ]; then
    failed=$((failed + silent))
  fi

cat <<ZZ
actualFailures:${failed}
totalTests:$((passed + failed))
expectedFailures:0
ZZ
}
